<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>ObsidianSync</Name>
  <Repository>mrbryo/ObsidianSync</Repository>
  <Registry>docker.io</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/mrbryo/ObsidianSync</Support>
  <Overview>CouchDB-based sync server for Obsidian Vault Management</Overview>
  <Category>Productivity</Category>
  <WebUI>http://[IP]:[PORT:5984]/_utils/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/mrbryo/ObsidianSync/main/unraid/template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/your-username/ObsidianSync/main/unraid/icon.png</Icon>
  <Image>couchdb:latest</Image>
  <Description>Sync Server for Obsidian Vaults</Description>
  
  <Environment>
    <Variable Name="COUCHDB_USER" Value="admin_user" Description="CouchDB Admin Username"/>
    <Variable Name="COUCHDB_PASSWORD" Value="admin_password" Description="CouchDB Admin Password"/>
  </Environment>
  
  <Ports>
    <Port Name="CouchDB Port" HostPort="5984" ContainerPort="5984" Protocol="tcp"/>
  </Ports>
  
  <Volumes>
    <Volume Name="CouchDB Data" HostPath="/mnt/user/appdata/ObsidianSync/data" ContainerPath="/opt/couchdb/data" Access="rw"/>
    <Volume Name="CouchDB Config" HostPath="/mnt/user/appdata/ObsidianSync/config" ContainerPath="/opt/couchdb/etc" Access="rw"/>
  </Volumes>
</Container>
